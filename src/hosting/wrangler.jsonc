// The hosted copy of the brief. `HOSTING.md` is the runbook; `worker.ts` says
// why it is shaped this way. Nothing in this file is per-installation: no
// account id, no resource id, no hostname, no email address. Wrangler takes
// the account from `wrangler login`, the hostname from `--domain` at deploy
// time, and who may read the page is the Access policy's business, set in the
// dashboard.
{
  "name": "aula-brief",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",

  // One hostname, the `--domain` one, with Access in front of it. The
  // workers.dev and preview URLs would each be another way in to the same
  // data, needing an Access application of their own.
  "workers_dev": false,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [{ "name": "BRIEF_STORE", "class_name": "BriefStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BriefStore"] }],

  // `wrangler dev` only: stands in for Access so `ctx.access` exists locally.
  // A deployed Worker ignores it and gets the real thing or nothing.
  "access": { "dev": { "aud": "aula-brief-dev" } },

  "observability": { "enabled": true },
}
