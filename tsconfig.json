{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],

    // Bun resolves and transpiles rather than emitting, so imports keep their
    // real ".ts" extension and nothing here is ever compiled to disk.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "evals/**/*.ts"],

  // Everything under src/browser runs in the browser, so it is a separate
  // project with a separate lib — see src/browser/tsconfig.json. The exclude is
  // a no-op for login.tsx (the include above never matched ".tsx" anyway) and
  // exists for the next file: a plain ".ts" helper added next to it would
  // otherwise land here and be checked against a lib with no DOM at all.
  //
  // bundle.ts is still pulled into this program by the macro import in
  // login-page.ts, which is right — a file calling Bun.spawnSync belongs to the
  // project that has Bun's types and not the DOM's.
  "exclude": ["src/browser/**"]
}
