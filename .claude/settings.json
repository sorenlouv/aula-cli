{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/format-hook.sh\" 2>/dev/null || true",
            "statusMessage": "Prettier",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
